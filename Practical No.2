#include <iostream>
#include <string>
#include <algorithm>
using namespace std;

// Node for Stack
struct Node {
    char data;
    Node* next;
};

// Stack ADT
class Stack {
    Node* top;

public:
    Stack() {
        top = NULL;
    }

    void push(char x) {
        Node* n = new Node;
        n->data = x;
        n->next = top;
        top = n;
    }

    char pop() {
        if (top == NULL)
            return '\0';

        char x = top->data;
        Node* temp = top;
        top = top->next;
        delete temp;
        return x;
    }

    char peek() {
        if (top == NULL)
            return '\0';
        return top->data;
    }

    bool empty() {
        return top == NULL;
    }
};

int priority(char op) {
    if (op == '^')
        return 3;
    if (op == '*' || op == '/')
        return 2;
    if (op == '+' || op == '-')
        return 1;
    return 0;
}

// Infix to Postfix
string postfix(string exp) {
    Stack s;
    string ans;

    for (char c : exp) {
        if (isalnum(c))
            ans += c;
        else if (c == '(')
            s.push(c);
        else if (c == ')') {
            while (s.peek() != '(')
                ans += s.pop();
            s.pop();
        }
        else {
            while (!s.empty() && priority(s.peek()) >= priority(c))
                ans += s.pop();
            s.push(c);
        }
    }

    while (!s.empty())
        ans += s.pop();

    return ans;
}

// Infix to Prefix
string prefix(string exp) {
    reverse(exp.begin(), exp.end());

    for (char &c : exp) {
        if (c == '(')
            c = ')';
        else if (c == ')')
            c = '(';
    }

    string ans = postfix(exp);
    reverse(ans.begin(), ans.end());

    return ans;
}

int main() {
    string exp;

    cout << "Enter infix expression: ";
    cin >> exp;

    cout << "Postfix: " << postfix(exp) << endl;
    cout << "Prefix: " << prefix(exp) << endl;

    return 0;
}